node_modules/
.env
.env.local
__pycache__/
*.pyc
dist/
build/
.next/
.DS_Store
*.gguf
.data/
tests/fixtures/

# User-owned LLM endpoint settings (managed via the Settings UI).
# Persists across restarts; delete the file to revert to .env / defaults.
settings.json
settings.json.tmp

# Decision Engine: heavy artifacts stay out of git; worker code + setup
# scripts under .decision-engine/ ARE tracked (100% project-local runtime).
.decision-engine/.venv/
.decision-engine/.cache/
.decision-engine/bin/
.decision-engine/models/

# Engine lifecycle: engine/manifest.json IS tracked (bootstrap+version metadata,
# B5 final decision 2026-11-22); the declared OPTIONAL upstream source-checkout
# slots under engine/vendor/ are not - nothing downloads there automatically.
engine/vendor/

# playwright-cli transient page snapshots (regenerated every session)
.playwright-cli/page-*.yml

# transient dev/test artifacts (Playwright coordination lock + run logs)
.cache/
.ai-coordination/

# Web Search & Research Engine: all local storage (SQLite caches, scraped-page
# caches, vendor fallback lists) lives under .local-search/ and stays out of
# git. The directory is auto-created on first use.
.local-search/

# Bundled context dumps (never commit)
repomix-output*.xml

# Browser engine runtime state (never commit): the persisted authority
# store (user's saved per-host permission rules) and the engine-owned
# downloads directory that tab downloads / uploads land in.
ruke-browser-policy.json
downloads/

# graphify generated graph output (regenerated by the source watcher)
graphify-out/

 the human belong in read_page, not here.\\\",\\\"parameters\\\":{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"queries\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\"},\\\"minItems\\\":1,\\\"maxItems\\\":4,\\\"description\\\":\\\"new keyword-form searches (3-6 keywords each); never repeat a query already run this turn\\\"},\\\"missing_claims\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\"},\\\"minItems\\\":1,\\\"maxItems\\\":6,\\\"description\\\":\\\"the specific facts the current evidence cannot answer\\\"},\\\"desired_source_types\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\",\\\"enum\\\":[\\\"general\\\",\\\"news\\\",\\\"docs\\\",\\\"code\\\",\\\"academic\\\",\\\"forum\\\"]},\\\"description\\\":\\\"optional source-family preference; the first entry steers the query intent\\\"},\\\"freshness\\\":{\\\"type\\\":\\\"string\\\",\\\"enum\\\":[\\\"none\\\",\\\"day\\\",\\\"week\\\",\\\"month\\\",\\\"year\\\",\\\"realtime\\\",\\\"any\\\"],\\\"description\\\":\\\"time scope of the facts sought (omit for timeless facts)\\\"},\\\"reason\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"one short line: why this search is needed\\\"}},\\\"required\\\":[\\\"queries\\\",\\\"missing_claims\\\"],\\\"additionalProperties\\\":false}}},{\\\"type\\\":\\\"function\\\",\\\"function\\\":{\\\"name\\\":\\\"read_page\\\",\\\"description\\\":\\\"Fetch up to 8 public web pages as readable text in ONE call (one tool round buys N pages). Pass the exact URLs; unsafe or blocked pages come back as structured failures, never as guesses. focus (optional) prunes off-topic sections of the fetched pages against the given terms. Returned passages are addressed §1, §2… per fetched document block; when a page reports truncated/dropped content, call read_page again on that URL with continuation:true (optionally a different focus) to retrieve the remaining blocks from the server's retained copy — no re-fetch, same [S#].\\\",\\\"parameters\\\":{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"urls\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\"},\\\"minItems\\\":1,\\\"maxItems\\\":8,\\\"description\\\":\\\"exact page URLs to read; batch every URL you need into ONE call\\\"},\\\"focus\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"optional terms used to prune off-topic sections of the fetched pages\\\"},\\\"timeoutMs\\\":{\\\"type\\\":\\\"integer\\\",\\\"minimum\\\":1000,\\\"maximum\\\":60000,\\\"description\\\":\\\"optional wall clock for the whole batch in ms (default 20000)\\\"},\\\"continuation\\\":{\\\"type\\\":\\\"boolean\\\",\\\"description\\\":\\\"true re-serves sections of THIS session's already-fetched pages that an earlier read left out (dropped blocks, un-returned focus windows) — no re-fetch; use it when a page reports truncated/dropped content instead of fetching it again\\\"}},\\\"required\\\":[\\\"urls\\\"],\\\"additionalProperties\\\":false}}}]}\","

# Copy to .env.local and fill in. Never commit real keys.
#
# ONE provider configuration, read the same way by the Next.js app, the Rust server and the
# Python capability backend. Precedence per key, highest first:
#   1. settings.json      - what you chose in the app's Settings UI (gitignored; delete it to
#                           fall back to this file's chain)
#   2. the process environment
#   3. .env.local         - this file, once copied
#   4. the built-in fallback below (never a personal absolute path)
# Chat and lifecycle resolve through that one chain, and the unload/reload URLs are DERIVED
# FROM THE CHAT URL ORIGIN, so a handoff can never unload one server while chat keeps
# talking to another. Python resolver: python-backend/ruke_ml/models/provider_config.py.
#
# Local model server (Strata / llama.cpp / Ollama, OpenAI-compatible endpoint).
LLM_API_URL=http://127.0.0.1:8080/v1/chat/completions
LLM_API_KEY=no-key
#
# Optional: provider identity and model identity hints, recorded in handoff journals and
# health output so an operator can see what was parked. Empty means "detect from the server".
RUKE_LLM_PROVIDER=
RUKE_LLM_MODEL=
#
# Optional: override the CONTROL origin used for lifecycle calls only. Leave empty to derive
# it from LLM_API_URL. Set it only when the control plane really is a different host/port.
RUKE_LLM_ENDPOINT=
#
# Optional: name the base that /unload and /load are appended to, WITH ITS PATH PREFIX kept.
# Use this when the provider's lifecycle endpoints live under a prefix (a gateway tenant path,
# a llama.cpp mount) instead of at the root. Leave empty for the default, which is the control
# origin plus /unload and /load - that is what this deployment's Strata server actually serves.
# RUKE_LIFECYCLE_BASE beats RUKE_LLM_ENDPOINT for both lifecycle URLs at once; LLM_UNLOAD_URL and
# LLM_RELOAD_URL below beat it individually. Never set only one of the pair unless the provider
# really has asymmetric paths.
RUKE_LIFECYCLE_BASE=

# Optional: explicit lifecycle endpoints. Leave empty to derive <control origin>/unload and
# <control origin>/load. Only set these when the provider's real paths differ, and only for a
# provider whose lifecycle API has actually been validated - an unsupported provider must
# report a capability limitation rather than pretend an unload succeeded.
LLM_UNLOAD_URL=
LLM_RELOAD_URL=
#
# Automatic resource handoff (default: enabled). This is the POLICY that lets a heavy document,
# OCR, ASR or video job park the main model when it cannot otherwise fit; it is not a licence to
# unload freely. A job still has to fail admission on measured RAM/commit/VRAM, the provider has
# to support lifecycle calls, and inference is drained first. Set 0/false to forbid unloading:
# jobs that do not fit then return a typed resource-limit result instead.
RUKE_LLM_AUTOMATIC_HANDOFF=1
# Legacy per-run spelling of the same policy, kept for operator scripts:
# RUKE_OCR_ALLOW_UNLOAD=1

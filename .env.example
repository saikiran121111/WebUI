# Copy to .env.local and fill in. Never commit real keys.

# Local model server (Strata / llama.cpp, OpenAI-compatible endpoint).
LLM_API_URL=http://127.0.0.1:8080/v1/chat/completions
LLM_API_KEY=no-key

# Optional — genuine AI mesh generation (asset3d mode B). The key is read
# only by server routes; the browser never sees it. Leave unset and the app
# keeps procedural scene3d and tells the user honestly that no provider is
# configured.
MESHY_API_KEY=

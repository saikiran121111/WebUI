    "note": "exactly one [DONE] per error frame; the proxy/route never appends its own [DONE] after raw upstream bytes; frames are byte-pinned by fixtures/sse + ruke-server sse.rs tests"
  },
  "headersCaseRule": "HTTP field names are case-insensitive; this ledger pins the lowercase canonical spelling. The Rust http crate forces lowercase (HeaderName::from_static); the TS chat route writes X-Used-Skill/X-Web-Citations/X-Search-Gate in PascalCase — binders therefore compare case-insensitively and catch RENAME drift, not case restyles.",
  "headers": [
    {
      "name": "x-decision-mode",
      "emitted": "every chat response (TS and Rust), stream and non-stream"
    },
    {
      "name": "x-used-skill",
      "emitted": "chat response only when a USER-tier skill was injected"
    },
    {
      "name": "x-web-citations",
      "encoding": "url-encoded JSON",
      "emitted": "legacy non-stream path only; streamed turns carry web_meta stage frames instead"
    },
    {
      "name": "x-search-gate",
      "encoding": "url-encoded JSON",
      "emitted": "legacy non-stream path only; progress path never carries web headers"
    },
    {
      "name": "x-ruke-internal-secret",
      "emitted": "internal RPC legs only (Rust bridge -> Next /api/internal/*); loopback-only; NEVER browser-visible and NEVER logged (Rule 17)"
    }
  ],
  "rpc": {
    "secretHeader": "x-ruke-internal-secret",
    "env": {
      "rustBridgeBaseUrl": "RUKE_BROWSER_BRIDGE_BASE_URL",
      "rustBridgeSecret": "RUKE_BROWSER_BRIDGE_SECRET",
      "nextArmSwitch": "RUKE_RUST_BACKEND",
      "backendPort": "RUKE_BACKEND_PORT",
      "rustProjectRoot": "RUKE_PROJECT_ROOT",
      "serverBinOverride": "RUKE_SERVER_BIN"
    },
    "browserRead": {
      "path": "/api/internal/browser-read",
      "method": "POST",
      "requestFields": [
        "url",
        "timeoutMs"
      ],
      "timeoutDefaultMs": 40000,
      "clientDeadlineSlackMs": 20000,
      "deadlineRule": "Rust client request timeout = timeoutMs (default 40000) + 20000 slack (browser_bridge.rs deadline_ms); the Next leg owns nav/response-size budgets",
      "errors": {
        "unauthorized": "unauthorized",
        "malformedBody": "Malformed JSON body",
        "urlRequired": "url required"
      },
      "responseFields": [
        "url",
        "finalUrl",
        "title",
        "status",
        "bodyText",
        "ariaSnapshot",
        "jsonLd",
        "meta",
        "windowState",
        "ok",
        "error"
      ],

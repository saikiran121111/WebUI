{
  "_meta": {
    "scenario": "upstream HTTP 500 with long error text (legacy path)",
    "semantics": "Same branch as 4xx; the upstream error text is sliced to its FIRST 200 CHARACTERS inside the message — fixture pins the exact cut.",
    "comparison": "byte-exact",
    "harness": "__tests__/rust-golden/errors.test.ts",
    "env": {
      "WEB_SEARCH_GATE_DISABLED": "1",
      "settings_llm_override": "http://127.0.0.1:9/v1/chat/completions"
    },
    "normalization": "Stage-event \"ms\" timing values replaced with \"<ms>\" in logicalFrames; progress-path bodies are ms-normalized text."
  },
  "request": {
    "rawBody": "{\"model\":\"strata-mock\",\"stream\":false,\"messages\":[{\"role\":\"user\",\"content\":\"fail hard\"}]}"
  },
  "upstreamCalls": [
    {
      "url": "http://127.0.0.1:9/v1/chat/completions",
      "method": "POST",
      "headers": {
        "accept": "text/event-stream",
        "authorization": "Bearer golden-key",
        "content-type": "application/json"
      },
      "bodyText": "{\"model\":\"strata-mock\",\"stream\":false,\"messages\":[{\"role\":\"user\",\"content\":\"fail hard\"}]}"
    }
  ],
  "response": {
    "status": 500,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "bytes": 235,
      "utf8Lossy": "{\"error\":\"Upstream returned 500: upstream exploded: XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\"}"
    }
  },
  "logicalFrames": [],
  "streamDone": false,
  "unterminatedTail": "{\"error\":\"Upstream returned 500: upstream exploded: XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\"}"
}

{
  "_meta": {
    "scenario": "normal streaming chat (no attachments, no web)",
    "semantics": "Progress path: early-open SSE 200, base streaming headers + x-decision-mode; first frame decision_done; raw upstream bytes forwarded scrubbed; route NEVER appends [DONE] itself. Upstream data frames inside the body are byte-stable; only the stage frame's ms digits vary, so the body is stored ms-normalized.",
    "comparison": "structural",
    "harness": "__tests__/rust-golden/chat-core.test.ts",
    "env": {
      "WEB_SEARCH_GATE_DISABLED": "1",
      "settings_llm_override": "http://127.0.0.1:9/v1/chat/completions"
    },
    "normalization": "Stage-event \"ms\" timing values replaced with \"<ms>\" in logicalFrames; progress-path response bodies are stored ms-normalized (raw bytes carry volatile ms digits)."
  },
  "request": {
    "rawBody": "{\"model\":\"strata-mock\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"hello there\"}]}"
  },
  "upstreamCalls": [
    {
      "url": "http://127.0.0.1:9/v1/chat/completions",
      "method": "POST",
      "headers": {
        "accept": "text/event-stream",
        "authorization": "Bearer golden-key",
        "content-type": "application/json"
      },
      "bodyText": "{\"model\":\"strata-mock\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"hello there\"}]}",
      "bodyJson": {
        "model": "strata-mock",
        "stream": true,
        "messages": [
          {
            "role": "user",
            "content": "hello there"
          }
        ]
      },
      "anchors": []
    }
  ],
  "response": {
    "status": 200,
    "headers": {
      "cache-control": "no-cache, no-transform",
      "connection": "keep-alive",
      "content-type": "text/event-stream",
      "x-accel-buffering": "no",
      "x-decision-mode": "standard_chat"
    },
    "body": {
      "bodyMsNormalized": "data: {\"ruke_stage\":{\"stage\":\"decision_done\",\"mode\":\"standard_chat\",\"ms\":\"<ms>\"}}\n\ndata: {\"id\":\"c1\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"}}]}\n\ndata: {\"id\":\"c1\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello!\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n",
      "note": "raw byte stream contains volatile ms digits in stage frames; compare logicalFrames + bodyMsNormalized, never raw bytes"
    }
  },
  "logicalFrames": [
    {
      "kind": "stage",
      "obj": {
        "stage": "decision_done",
        "mode": "standard_chat",
        "ms": "<ms>"
      }
    },
    {
      "kind": "data",
      "obj": {
        "id": "c1",
        "choices": [
          {
            "index": 0,
            "delta": {
              "role": "assistant"
            }
          }
        ]
      },
      "raw": "{\"id\":\"c1\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"}}]}"
    },
    {
      "kind": "data",
      "obj": {
        "id": "c1",
        "choices": [
          {
            "index": 0,
            "delta": {
              "content": "Hello!"
            },
            "finish_reason": "stop"
          }
        ]
      },
      "raw": "{\"id\":\"c1\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello!\"},\"finish_reason\":\"stop\"}]}"
    },
    {
      "kind": "done"
    }
  ],
  "streamDone": true,
  "unterminatedTail": ""
}

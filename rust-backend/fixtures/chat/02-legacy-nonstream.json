{
  "_meta": {
    "scenario": "legacy non-streaming consumer (stream === false)",
    "semantics": "Only stream === false selects the legacy branch (early response, metadata in HEADERS, ZERO ruke_stage frames). Upstream bytes still forwarded verbatim.",
    "comparison": "byte-exact",
    "harness": "__tests__/rust-golden/chat-core.test.ts",
    "env": {
      "WEB_SEARCH_GATE_DISABLED": "1",
      "settings_llm_override": "http://127.0.0.1:9/v1/chat/completions"
    },
    "normalization": "Stage-event \"ms\" timing values replaced with \"<ms>\" in logicalFrames; progress-path response bodies are stored ms-normalized (raw bytes carry volatile ms digits). P1 (2026-11-01): the live <runtime_clock> system block carries wall-clock text, so its content is MASKED in bodyText/bodyJson (the clock text itself is pinned by clock unit tests)."
  },
  "request": {
    "rawBody": "{\"model\":\"strata-mock\",\"stream\":false,\"messages\":[{\"role\":\"user\",\"content\":\"hello there\"}]}"
  },
  "upstreamCalls": [
    {
      "url": "http://127.0.0.1:9/v1/chat/completions",
      "method": "POST",
      "headers": {
        "accept": "text/event-stream",
        "authorization": "Bearer golden-key",
        "content-type": "application/json"
      },
      "bodyText": "{\"model\":\"strata-mock\",\"stream\":false,\"messages\":[{\"role\":\"user\",\"content\":\"hello there\"},{\"role\":\"system\",\"content\":\"<runtime_clock>MASKED</runtime_clock>\"}]}",
      "bodyJson": {
        "model": "strata-mock",
        "stream": false,
        "messages": [
          {
            "role": "user",
            "content": "hello there"
          },
          {
            "role": "system",
            "content": "<runtime_clock>MASKED</runtime_clock>"
          }
        ]
      },
      "anchors": []
    }
  ],
  "response": {
    "status": 200,
    "headers": {
      "cache-control": "no-cache, no-transform",
      "connection": "keep-alive",
      "content-type": "text/event-stream",
      "x-accel-buffering": "no",
      "x-decision-mode": "standard_chat"
    },
    "body": {
      "bytes": 181,
      "utf8Lossy": "data: {\"id\":\"c1\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"}}]}\n\ndata: {\"id\":\"c1\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello!\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"
    }
  },
  "logicalFrames": [
    {
      "kind": "data",
      "obj": {
        "id": "c1",
        "choices": [
          {
            "index": 0,
            "delta": {
              "role": "assistant"
            }
          }
        ]
      },
      "raw": "{\"id\":\"c1\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"}}]}"
    },
    {
      "kind": "data",
      "obj": {
        "id": "c1",
        "choices": [
          {
            "index": 0,
            "delta": {
              "content": "Hello!"
            },
            "finish_reason": "stop"
          }
        ]
      },
      "raw": "{\"id\":\"c1\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello!\"},\"finish_reason\":\"stop\"}]}"
    },
    {
      "kind": "done"
    }
  ],
  "streamDone": true,
  "unterminatedTail": ""
}
